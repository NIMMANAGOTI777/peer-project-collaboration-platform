# Environment Variables for Peer Project Collaboration Platform

# Database Connection (SQLite default for zero-setup demo, PostgreSQL compatible)
DATABASE_URL="file:./dev.db"

# For PostgreSQL (e.g. Supabase, Neon, or local Postgres):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peer_collab_db?schema=public"

# Authentication Secret
AUTH_SECRET="peer-project-super-secret-jwt-key-2026-btech-cse"
JWT_EXPIRES_IN="7d"

# GitHub API (Optional: personal access token for higher rate limits)
# GITHUB_TOKEN="ghp_your_github_token"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
